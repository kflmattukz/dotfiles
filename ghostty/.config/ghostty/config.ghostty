# Look
font-family = JetBrainsMono Nerd Font
font-style = Medium
font-size = 13
font-feature = +liga
# font-feature = +ss03
# Themes live in ~/.config/ghostty/themes (this build ships none)
theme = light:tokyonight-day,dark:tokyonight
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-theme = ghostty
gtk-titlebar-hide-when-maximized = true
cursor-style = bar
cursor-style-blink = false

# Behavior
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo
# New tab/split opens in current directory (needs shell integration, on by default)
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Translucent background (blur is not supported on GNOME)
background-opacity = 0.9

# Keys: | splits side by side, _ splits top/bottom
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+minus=new_split:down
