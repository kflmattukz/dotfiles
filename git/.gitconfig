[user]
	name = kflmattukz
	email = kflmattukz@gmail.com
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[merge]
	conflictstyle = zdiff3
[credential]
	helper = libsecret
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
# Machine/work-specific config (untracked): work identities, internal hosts
[include]
	path = ~/.gitconfig.local
